# Copy this file to .env.local and fill in the values.

# --- Email (Gmail SMTP) ----------------------------------------------------
# Generate an app password at https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on the account first).
GMAIL_USER=csdevelopmentsupport@gmail.com
GMAIL_APP_PASSWORD=

# --- MongoDB Atlas ---------------------------------------------------------
# Atlas > Connect > Drivers gives you this string. Put the database name
# before the "?", for example .../csdev?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/csdev?retryWrites=true&w=majority

# Public DNS resolvers used only for the Atlas SRV lookup. Many home and
# campus networks refuse SRV queries, which shows up as
# "querySrv ECONNREFUSED _mongodb._tcp...". Leave this unset to use
# 1.1.1.1 and 8.8.8.8, set your own list, or set it to "system" to use the
# machine's resolvers.
# MONGODB_DNS=1.1.1.1,8.8.8.8

# --- Form endpoint (used by the frontend) ----------------------------------
# Keep the trailing slash: next.config.mjs sets trailingSlash, so posting to
# "/api/contact" would be redirected and take an extra round trip.
NEXT_PUBLIC_FORM_ENDPOINT=/api/contact/

# --- Public site URL (used for hreflang and social links) ------------------
# Set this to your real domain in production, for example https://csdevtech.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
